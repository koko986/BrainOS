SECOND_BRAIN_DB_PATH=data/database/second_brain.db
SECOND_BRAIN_PROLOG_DIR=prolog

# Conversation and reasoning model.
# "agent" gives MARLIN tool calling, which is what lets it read and edit files.
SECOND_BRAIN_CONVERSATION_PROVIDER=agent
SECOND_BRAIN_LLM_PROVIDER=groq
SECOND_BRAIN_GROQ_MODEL=openai/gpt-oss-120b
# Required. Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Speech to text. groq uses whisper-large-v3-turbo, the fastest accurate
# multilingual option. Set to "vosk" to stay fully offline.
SECOND_BRAIN_STT_PROVIDER=groq
SECOND_BRAIN_GROQ_STT_MODEL=whisper-large-v3-turbo
# Leave blank to auto-detect the spoken language, or set e.g. en or my.
SECOND_BRAIN_STT_LANGUAGE=

# Offline wake word. Install the model with: python scripts/setup_voice.py
SECOND_BRAIN_WAKE_WORD_ENABLED=true
SECOND_BRAIN_WAKE_WORDS=marlin,hey marlin,hey marlon,hey merlin
SECOND_BRAIN_VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15

# Microphone endpointing. Recording stops after this much silence.
SECOND_BRAIN_VOICE_MAX_SECONDS=12
SECOND_BRAIN_VOICE_SILENCE_SECONDS=0.8
SECOND_BRAIN_VOICE_START_TIMEOUT=8

# Spoken replies.
SECOND_BRAIN_TERMINAL_VOICE_OUTPUT=true
SECOND_BRAIN_TTS_PROVIDER=windows
SECOND_BRAIN_VOICE_MODE=fast

# File and computer access. "full" means MARLIN may read, write, and delete
# anything without asking. Every action is written to the local audit log.
SECOND_BRAIN_FILE_ACCESS=full
SECOND_BRAIN_ALLOWED_APPS=notepad,calculator,explorer,vscode,chrome

SECOND_BRAIN_COCKPIT_HOST=127.0.0.1
SECOND_BRAIN_COCKPIT_PORT=8765

# Canned local replies for greetings. Leave false so real requests always
# reach the agent.
SECOND_BRAIN_FAST_LOCAL_CONVERSATION=false

# Optional OpenCode conversation backend.
SECOND_BRAIN_OPENCODE_COMMAND=opencode
SECOND_BRAIN_OPENCODE_MODEL=opencode/muse-spark-1.2-contributor-free
SECOND_BRAIN_OPENCODE_TIMEOUT_SECONDS=6
SECOND_BRAIN_OPENCODE_USE_SERVER=true
SECOND_BRAIN_OPENCODE_SERVER_HOST=127.0.0.1
SECOND_BRAIN_OPENCODE_SERVER_PORT=4096
SECOND_BRAIN_OPENCODE_CONTINUE_SESSION=true
