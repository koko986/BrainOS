# MARLIN V2 is fully local. No API key is required.
MARLIN_DB_PATH=data/database/second_brain.db
MARLIN_PROLOG_DIR=prolog
MARLIN_HOST=127.0.0.1
MARLIN_PORT=8765

MARLIN_OLLAMA_URL=http://127.0.0.1:11434
MARLIN_OLLAMA_MODEL=qwen3:4b-instruct
MARLIN_OLLAMA_KEEP_ALIVE=30m
MARLIN_OLLAMA_CONTEXT=2048
MARLIN_OLLAMA_MAX_TOKENS=160

MARLIN_WHISPER_MODEL=small
MARLIN_WHISPER_DEVICE=cpu
MARLIN_WHISPER_COMPUTE=int8
MARLIN_VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
MARLIN_WAKE_WORD_ENABLED=true

MARLIN_PIPER_VOICE=en_GB-alan-medium
MARLIN_PIPER_DATA_DIR=models/piper
MARLIN_VOICE_OUTPUT=true

MARLIN_AUTO_INDEX_C=true
MARLIN_INDEX_BATCH_SIZE=5000
MARLIN_WEATHER_ENABLED=true
MARLIN_WEATHER_LATITUDE=16.8409
MARLIN_WEATHER_LONGITUDE=96.1735
MARLIN_LAUNCH_ON_LOGIN=false
